{
  "datasets": [
    {
      "name": "violations_by_domain",
      "displayName": "Violations by Domain",
      "queryLines": [
        "SELECT\n",
        "  policy_domain,\n",
        "  COUNT(*) AS violation_count\n",
        "FROM\n",
        "  policyiq.silver.kpi_compliance_facts\n",
        "WHERE\n",
        "  is_compliant = FALSE\n",
        "GROUP BY\n",
        "  policy_domain\n",
        "ORDER BY\n",
        "  violation_count DESC"
      ],
      "catalog": "policyiq",
      "schema": "silver"
    },
    {
      "name": "cca9474f",
      "displayName": "compliance_overview",
      "queryLines": [
        "SELECT\n",
        "  branch_id, branch_name, division, region_risk_classification,\n",
        "  policy_domain, kpi_display_name, policy_id, policy_section_ref,\n",
        "  actual_value, threshold_value, threshold_operator, unit,\n",
        "  compliance_status, raw_gap, as_of_date\n",
        "FROM policyiq.silver.kpi_compliance_facts"
      ]
    },
    {
      "name": "d4f21861",
      "displayName": "violations_by_branch",
      "queryLines": [
        "SELECT branch_name, count(*) AS violation_count\n",
        "FROM policyiq.silver.kpi_compliance_facts\n",
        "WHERE compliance_status = 'Non-Compliant'\n",
        "GROUP BY branch_name"
      ]
    },
    {
      "name": "2545bf6c",
      "displayName": "Untitled dataset",
      "queryLines": [
        ""
      ]
    },
    {
      "name": "overall_compliance_rate",
      "displayName": "Overall Compliance Rate",
      "queryLines": [
        "SELECT\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN compliance_status = 'Compliant' THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS compliance_rate_pct\n",
        "FROM\n",
        "  policyiq.silver.kpi_compliance_facts"
      ]
    },
    {
      "name": "034b82d1",
      "displayName": "policy_registry_view",
      "queryLines": [
        "-- policy_registry_view\n",
        "SELECT policy_name, policy_domain, issuing_authority, version, effective_date, is_synthetic\n",
        "FROM policyiq.bronze.policy_registry\n",
        "ORDER BY is_synthetic ASC, policy_domain"
      ]
    },
    {
      "name": "223cd337",
      "displayName": "kpi_registry_view",
      "queryLines": [
        "-- kpi_registry_view\n",
        "SELECT kpi_display_name, policy_domain, policy_section_ref, unit, threshold_operator, threshold_value, notes\n",
        "FROM policyiq.bronze.kpi_registry\n",
        "ORDER BY policy_domain, kpi_display_name"
      ]
    }
  ],
